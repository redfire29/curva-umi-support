---
import "../assets/css/main.css";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import AppHeader from "../components/AppHeader.svelte";
import AppFooter from "../components/AppFooter.svelte";
import { ui } from "../i18n/ui";

interface Props {
    title?: string;
    description?: string;
    frontmatter?: { title?: string; description?: string }; // Fallback if using markdown layout
}

const { currentLocale } = Astro;
const locale = currentLocale || "ja";
const messages = ui[locale as keyof typeof ui] || ui["ja"];

const { title, description } = Astro.props;
const displayTitle = title || Astro.props.frontmatter?.title || "Home";
const displayDescription =
    description ||
    Astro.props.frontmatter?.description ||
    messages["site-description"];

const base = import.meta.env.BASE_URL;
let path = Astro.url.pathname;
if (path.startsWith(base)) {
    path = path.slice(base.length);
}
if (path.startsWith("/")) {
    path = path.slice(1);
}
if (locale !== "ja" && path.startsWith(locale)) {
    path = path.slice(locale.length);
    if (path.startsWith("/")) {
        path = path.slice(1);
    }
}
const slug = path;
const isDarkHeader = slug.startsWith("songlist");

const jaURL = getAbsoluteLocaleUrl("ja", slug);
const zhURL = getAbsoluteLocaleUrl("zh", slug);

const ogLocale = locale === "ja" ? "ja_JP" : "zh_TW";
const ogLocaleAlternate = locale === "ja" ? "zh_TW" : "ja_JP";

// Remove base path /curva-umi-support
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
    "/curva-umi-support/og-image.jpeg",
    Astro.site,
).toString();

const siteURL = new URL(base, Astro.site).toString();
const schemaData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${siteURL}#website`,
            "url": siteURL,
            "name": "來羽うみSupport",
            "description": displayDescription,
            "inLanguage": locale === "ja" ? "ja-JP" : "zh-TW"
        },
        {
            "@type": "ProfilePage",
            "@id": `${canonicalURL}#profile`,
            "url": canonicalURL.toString(),
            "name": `${displayTitle} - 來羽うみSupport`,
            "isPartOf": {
                "@id": `${siteURL}#website`
            },
            "about": {
                "@type": "Person",
                "name": "來羽うみ",
                "alternateName": "Curva Umi",
                "image": ogImage,
                "url": "https://x.com/curva_umi",
                "sameAs": [
                    "https://www.youtube.com/@curvaumi",
                    "https://x.com/curva_umi"
                ]
            }
        }
    ]
};
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Outfit:wght@400;500;700&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Outfit:wght@400;500;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Outfit:wght@400;500;700&display=swap"
                rel="stylesheet"
            />
        </noscript>
        {slug === "" && (
            <link
                rel="preload"
                as="image"
                href="/curva-umi-support/img/logo.jpeg"
                fetchpriority="high"
            />
        )}
        <link
            rel="icon"
            type="image/svg+xml"
            href="/curva-umi-support/favicon.svg"
        />
        <link
            rel="icon"
            type="image/png"
            href="/curva-umi-support/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="shortcut icon" href="/curva-umi-support/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/curva-umi-support/apple-touch-icon.png"
        />
        <link rel="manifest" href="/curva-umi-support/site.webmanifest" />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="ja" href={jaURL} />
        <link rel="alternate" hreflang="zh-TW" href={zhURL} />
        <meta name="generator" content={Astro.generator} />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta
            name="keywords"
            content="來羽うみSupport,curva-umi-support,curva umi support,來羽うみ,Curva Umi"
        />
        <meta name="description" content={displayDescription} />

        <!-- Open Graph -->
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={ogLocaleAlternate} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta
            property="og:title"
            content={`${displayTitle} - 來羽うみSupport`}
        />
        <meta property="og:description" content={displayDescription} />
        <meta property="og:image" content={ogImage} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content={`${displayTitle} - 來羽うみSupport`}
        />
        <meta name="twitter:description" content={displayDescription} />
        <meta name="twitter:image" content={ogImage} />

        <title>{displayTitle} - 來羽うみSupport</title>
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
        <slot name="head" />
    </head>
    <body class="flex flex-col h-full text-pearl-white min-h-screen">
        <AppHeader client:idle locale={locale} messages={messages} isDark={isDarkHeader} />
        <div class="flex-1 flex flex-col">
            <div class="w-full mx-auto flex-1 h-full">
                <slot />
            </div>
        </div>
        <AppFooter client:visible locale={locale} messages={messages} />

        <script>
            import AOS from "aos";
            import "aos/dist/aos.css";
            AOS.init({ once: true });
        </script>
    </body>
</html>
